# Copy to .env (never commit .env). Everything is optional: with no values the backend runs in memory.
PORT=3000
# MongoDB connection string. Leave empty to use the in-memory store.
MONGODB_URI=
MONGODB_DB=promoflow
# Comma-separated origins allowed to call the API (the extension and the demo store).
ALLOWED_ORIGINS=
# Only needed if you switch on an affiliate-feed source in backend/harvest/sources.json.
FEED_API_KEY=
